{
  "expo": {
    "name": "Lumen Liturgia",
    "slug": "lumen-liturgia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.lumen.liturgia",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Lumen envia lembretes diarios para leitura da liturgia."
      }
    },
    "android": {
      "package": "br.com.lumen.liturgia",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E5C35"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications"
    ],
    "extra": {
      "apiBaseUrl": "http://192.168.1.8:3333",
      "eas": {
        "projectId": "7dd0781f-0d04-4a5d-89e7-d59f517c49e4"
      }
    },
    "owner": "joaopaulooliveirasantos"
  }
}
