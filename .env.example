LITURGY_API_URL_TEMPLATE=https://feed.evangelizo.org/v2/reader.php
EVANGELIZO_LANG=PT
EVANGELIZO_CONTENT=GSP

# Fonte da liturgia diaria, cor liturgica e santo do dia: "ppr" (padrao), "cnbb" ou "evangelizo".
# Com "ppr", a homilia vem da secao "Meditação" do site (quando publicada; senao cai no Evangelizo).
# Com "cnbb"/"evangelizo", a homilia sempre vem do Evangelizo.
LITURGY_PROVIDER=ppr
